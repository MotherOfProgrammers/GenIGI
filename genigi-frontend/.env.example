# Required in production: 32+ random characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. https://genigi.example
BETTER_AUTH_URL=http://localhost:3000
# SQLite file; the default is ./auth.sqlite
AUTH_DB_PATH=
# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID, Web).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
